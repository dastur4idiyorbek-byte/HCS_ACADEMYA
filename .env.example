# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_bu_yerga_BotFather_tokeni
ADMIN_IDS=123456789,987654321

# --- Ma'lumotlar bazasi ---
# SQLite (standart). PostgreSQL ga o'tish: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///data/hcs.db

# --- Kapitalizatsiya reytingi (3.4-band, Top 30 Halal) ---
# CoinMarketCap bepul rejasi ham kalit talab qiladi:
# https://pro.coinmarketcap.com/signup  ->  API Key
CMC_API_KEY=

# --- Konfiguratsiya fayli ---
HCS_CONFIG_FILE=config/default.yaml

# --- Loglar ---
LOG_LEVEL=INFO
LOG_DIR=logs
